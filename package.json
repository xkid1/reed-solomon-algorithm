{
  "name": "@xkid1/reed-solomon-algorithm",
  "version": "0.1.1",
  "description": "Reed-Solomon algorithm error correction over GF(2^8) in pure TypeScript: encode, decode, correct errors and erasures.",
  "keywords": [
    "reed-solomon",
    "error-correction",
    "ecc",
    "galois-field",
    "gf256",
    "fec",
    "typescript"
  ],
  "homepage": "https://github.com/xkid1/reed-solomon-algorithm#readme",
  "bugs": "https://github.com/xkid1/reed-solomon-algorithm/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xkid1/reed-solomon-algorithm.git"
  },
  "license": "MIT",
  "author": "xkid1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "tsd": {
    "directory": "./global.d.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "yarn@4.18.0",
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": ">=4.0.0"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn clean && yarn build:js && yarn build:types",
    "build:js": "swc src -d dist --strip-leading-paths --ignore \"**/*.test.ts\" \"**/*.spec.ts\"",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn coverage && yarn build",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
